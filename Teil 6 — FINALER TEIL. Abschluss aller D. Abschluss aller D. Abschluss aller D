function validateEnv(): void {
  const required = ['API_BASE_URL', 'FIREBASE_CONFIG.apiKey', 'FIREBASE_CONFIG.projectId']
  const missing: string[] = []
  if (!env.API_BASE_URL) missing.push('VITE_API_BASE_URL')
  if (!env.FIREBASE_CONFIG.apiKey) missing.push('VITE_FIREBASE_API_KEY')
  if (!env.FIREBASE_CONFIG.projectId) missing.push('VITE_FIREBASE_PROJECT_ID')
