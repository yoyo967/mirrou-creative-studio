## Typed Env (Backend)
```ts
// backend/src/config/env.ts
import { z } from 'zod'
const EnvSchema = z.object({
  PORT: z.coerce.number().default(8080),
  NODE_ENV: z.enum(['development', 'staging', 'production']).default('development'),
  GCP_PROJECT: z.string().min(1),
  FIREBASE_PROJECT: z.string().min(1),
  VERTEX_AI_LOCATION: z.string().default('europe-west1'),
  GEMINI_MODEL: z.string().default('gemini-2.0-pro'),
  IMAGEN_MODEL: z.string().default('imagen-3'),
  EMBEDDING_MODEL: z.string().default('text-embedding-005'),
  GCS_BUCKET: z.string().default('agenticum-g5-assets'),
  PUBSUB_TOPIC: z.string().default('agenticum-events'),
  RATE_LIMIT_MAX: z.coerce.number().default(100),
  RATE_LIMIT_WINDOW_MS: z.coerce.number().default(60000),
  CORS_ORIGINS: z.string().default('https://online-marketing-manager.web.app,http://localhost:5173'),
  LOG_LEVEL: z.enum(['debug', 'info', 'warn', 'error']).default('info'),
})
export type Env = z.infer
function loadEnv(): Env {
  const result = EnvSchema.safeParse(process.env)
  if (!result.success) {
    console.error('Invalid environment configuration:')
    console.error(result.error.format())
    process.exit(1)
  }
  return result.data
}
export const env = loadEnv()
